# Platform API base. Leave empty to use the bundled mock API (/api/v1).
# Point it at the Laravel backend when it is available, e.g. https://api.carzen.app/api/v1
NEXT_PUBLIC_API_URL=

# Mock API simulated latency in ms (0 disables it).
MOCK_API_LATENCY=280

# ── Data source ──────────────────────────────────────────────
# mock (default): the in-memory demo store shared by both apps.
# supabase: the same /api/v1 routes served from the Supabase Postgres database.
CARZEN_DATA_SOURCE=mock

# Supabase data source only (server-side secrets: never prefix with NEXT_PUBLIC_).
# Dashboard → Connect → Session pooler (port 5432), with the database password.
# (The transaction pooler, port 6543, can hang requests that run many queries in parallel.)
DATABASE_URL=
# Dashboard → Project Settings → API: project URL and publishable (anon) key, used for sign-in.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Max connections per app server (default 5).
DATABASE_POOL_MAX=
# Dashboard → Project Settings → API keys → Secret key (sb_secret_…). Server-only: creates the
# Supabase Auth login (phone + temporary password) when an owner/manager adds staff.
SUPABASE_SECRET_KEY=

# The portal serves only /api/v1/vendor/*. Set to 1 to also serve the admin namespace (demo reset).
CARZEN_SERVE_ADMIN_API=
# Server time zone for "today", schedules and day closings (default Africa/Cairo, see instrumentation.ts).
TZ=

# ── Browser push (Firebase Cloud Messaging) ──────────────────
# Server-only: the Firebase service account JSON (raw or base64). Without it push is off.
FIREBASE_SERVICE_ACCOUNT=
# Shared secret of the database push hook (/api/v1/{vendor|admin}/push/hook); same value in Supabase Vault panel_push_secret.
PUSH_WEBHOOK_SECRET=
# Firebase web app (public values): Firebase console → Project settings → Your apps → Web app.
# The toggle in the notifications menu appears once these are set. VAPID key optional (Cloud Messaging → Web Push certificates).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
